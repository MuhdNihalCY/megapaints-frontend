{
    "$schema": "vscode://schemas/color-theme",
    "name": "Beautiful Dark",
    "type": "dark",
    "colors": {
        "focusBorder": "#399EE6",
        "foreground": "#E6E6E6",
        "widget.shadow": "#050505",
        "selection.background": "#399EE680",
        "errorForeground": "#F07171",
        "textLink.foreground": "#399EE6",
        "textLink.activeForeground": "#FA8D3E",
        "textPreformat.foreground": "#399EE6",
        "textSeparator.foreground": "#050505",
        "button.background": "#FA8D3E",
        "button.foreground": "#000000",
        "button.hoverBackground": "#d47735",
        "checkbox.background": "#2c2c2c",
        "dropdown.background": "#2c2c2c",
        "dropdown.border": "#363636",
        "input.background": "#2c2c2c",
        "input.border": "#363636",
        "inputValidation.errorBackground": "#F0717190",
        "inputValidation.errorBorder": "#F07171",
        "inputValidation.errorForeground": "#000000",
        "inputValidation.infoBackground": "#399EE690",
        "inputValidation.infoBorder": "#399EE6",
        "inputValidation.infoForeground": "#000000",
        "inputValidation.warningBackground": "#FA8D3E90",
        "inputValidation.warningBorder": "#FA8D3E",
        "inputValidation.warningForeground": "#000000",
        "scrollbar.shadow": "#050505",
        "scrollbarSlider.background": "#6c6c6c50",
        "scrollbarSlider.hoverBackground": "#85858540",
        "scrollbarSlider.activeBackground": "#52525240",
        "badge.background": "#F07171",
        "badge.foreground": "#000000",
        "progressBar.background": "#399EE6",
        "list.activeSelectionBackground": "#399EE620",
        "list.focusBackground": "#399EE630",
        "list.highlightForeground": "#FFCE6B",
        "list.hoverBackground": "#2c2c2c",
        "list.inactiveSelectionBackground": "#399EE625",
        "list.errorForeground": "#F07171",
        "list.warningForeground": "#FA8D3E",
        "activityBar.background": "#121212",
        "activityBar.inactiveForeground": "#b3b3b3",
        "activityBar.dropBorder": "#399EE6",
        "activityBarBadge.background": "#F07171",
        "activityBarBadge.foreground": "#000000",
        "activityBar.activeBorder": "#399EE6",
        "activityBar.activeBackground": "#399EE613",
        "activityBar.activeFocusBorder": "#399EE6",
        "sideBar.background": "#191919",
        "sideBarSectionHeader.background": "#262626",
        "minimap.selectionHighlight": "#399EE680",
        "minimap.errorHighlight": "#F07171",
        "minimap.warningHighlight": "#FA8D3E",
        "minimapGutter.addedBackground": "#78BD65",
        "minimapGutter.deletedBackground": "#F07171",
        "minimapGutter.modifiedBackground": "#399EE6",
        "editorGroup.border": "#121212",
        "editorGroup.dropBackground": "#399EE630",
        "editorGroupHeader.noTabsBackground": "#2c2c2c",
        "editorGroupHeader.tabsBackground": "#2c2c2c",
        "tab.activeBackground": "#1f1f1f",
        "tab.border": "#393939",
        "tab.activeBorder": "#399EE6",
        "tab.lastPinnedBorder": "#399EE650",
        "tab.inactiveBackground": "#2c2c2c",
        "tab.hoverBackground": "#393939",
        "tab.activeModifiedBorder": "#399EE6",
        "editorPane.background": "#151515",
        "editor.background": "#1f1f1f",
        "editor.foreground": "#E6E6E6",
        "editorLineNumber.foreground": "#525252",
        "editorLineNumber.activeForeground": "#9f9f9f",
        "editorCursor.background": "#000000",
        "editorCursor.foreground": "#399EE6",
        "editor.selectionBackground": "#399EE630",
        "editor.findMatchHighlightBackground": "#E6E6E630",
        "editor.findMatchBorder": "#399EE6",
        "editor.lineHighlightBackground": "#2c2c2c",
        "editorLink.activeForeground": "#399EE6",
        "editorWhitespace.foreground": "#525252",
        "editorIndentGuide.background": "#393939",
        "editorIndentGuide.activeBackground": "#399EE6",
        "editorRuler.foreground": "#393939",
        "editorBracketMatch.border": "#2c7ab3",
        "editorBracketMatch.background": "#1a1a1a",
        "editor.foldBackground": "#FA8D3E30",
        "editorOverviewRuler.border": "#393939",
        "editorOverviewRuler.selectionHighlightForeground": "#399EE6",
        "editorOverviewRuler.modifiedForeground": "#399EE6",
        "editorOverviewRuler.addedForeground": "#399EE6",
        "editorOverviewRuler.deletedForeground": "#399EE6",
        "editorOverviewRuler.errorForeground": "#F07171",
        "editorOverviewRuler.warningForeground": "#FA8D3E",
        "editorOverviewRuler.infoForeground": "#399EE6",
        "editorOverviewRuler.bracketMatchForeground": "#399EE6",
        "editorError.foreground": "#F07171",
        "editorWarning.foreground": "#FA8D3E",
        "editorInfo.foreground": "#399EE6",
        "problemsErrorIcon.foreground": "#F07171",
        "problemsWarningIcon.foreground": "#FA8D3E",
        "problemsInfoIcon.foreground": "#399EE6",
        "editorGutter.modifiedBackground": "#399EE6",
        "editorGutter.addedBackground": "#78BD65",
        "editorGutter.deletedBackground": "#F07171",
        "diffEditor.insertedTextBackground": "#78BD6530",
        "diffEditor.removedTextBackground": "#F0717135",
        "editorWidget.background": "#1f1f1f",
        "editorWidget.resizeBorder": "#393939",
        "editorSuggestWidget.background": "#2c2c2c",
        "editorSuggestWidget.border": "#393939",
        "editorSuggestWidget.highlightForeground": "#FFCE6B",
        "editorHoverWidget.border": "#393939",
        "editorMarkerNavigation.background": "#1f1f1f",
        "editorMarkerNavigationError.background": "#F07171",
        "editorMarkerNavigationWarning.background": "#FA8D3E",
        "editorMarkerNavigationInfo.background": "#399EE6",
        "peekViewResult.background": "#2c2c2c",
        "peekViewTitle.background": "#121212",
        "panel.dropBorder": "#399EE6",
        "panelTitle.activeBorder": "#399EE6",
        "statusBar.background": "#121212",
        "statusBarItem.hoverBackground": "#2c2c2c",
        "statusBarItem.prominentBackground": "#399EE6",
        "statusBarItem.prominentForeground": "#000000",
        "statusBarItem.prominentHoverBackground": "#338ccd",
        "titleBar.activeBackground": "#2c2c2c",
        "titleBar.inactiveBackground": "#1f1f1f",
        "titleBar.border": "#313131",
        "menu.background": "#1f1f1f",
        "menu.foreground": "#E6E6E6",
        "menu.selectionBackground": "#399EE6DD",
        "menu.selectionForeground": "#000000",
        "menu.separatorBackground": "#525252",
        "notificationsErrorIcon.foreground": "#F07171",
        "notificationsWarningIcon.foreground": "#FA8D3E",
        "notificationsInfoIcon.foreground": "#399EE6",
        "notifications.background": "#1f1f1f",
        "extensionButton.prominentBackground": "#FA8D3E",
        "extensionButton.prominentForeground": "#000000",
        "extensionButton.prominentHoverBackground": "#c77031",
        "pickerGroup.border": "#050505",
        "pickerGroup.foreground": "#399EE6",
        "terminal.selectionBackground": "#399EE6",
        "terminalCursor.foreground": "#399EE6",
        "terminalCursor.background": "#000000",
        "gitDecoration.addedResourceForeground": "#78BD65",
        "gitDecoration.modifiedResourceForeground": "#399EE6",
        "gitDecoration.deletedResourceForeground": "#F07171",
        "gitDecoration.stageDeletedResourceForeground": "#F07171",
        "gitDecoration.stageModifiedResourceForeground": "#399EE6",
        "settings.modifiedItemIndicator": "#399EE6",
        "notebook.focusedRowBorder": "#399EE6"
    },
    "tokenColors": [
        {
            "scope": "invalid",
            "settings": {
                "foreground": "#F07171"
            }
        },
        {
            "scope": [
                "meta.embedded",
                "source.groovy.embedded",
                "meta.template.expression"
            ],
            "settings": {
                "foreground": "#E6E6E6"
            }
        },
        {
            "scope": [
                "variable",
                "punctuation.definition.variable",
                "support.variable.property.dom",
                "support.variable.dom",
                "support.variable.property",
                "punctuation.separator.parameter",
                "string.interpolated.pug variable"
            ],
            "settings": {
                "foreground": "#E6E6E6"
            }
        },
        {
            "scope": ["comment", "punctuation.definition.comment"],
            "settings": {
                "foreground": "#787878"
            }
        },
        {
            "scope": ["string", "punctuation.definition.string"],
            "settings": {
                "foreground": "#2755a0"
            }
        },
        {
            "scope": "constant.character.escape",
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": ["keyword", "constant.language.import-export-all"],
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": [
                "entity.name.type",
                "support.type.primitive",
                "support.type.builtin",
                "meta.type.annotation entity.name.type",
                "meta.type.parameters entity.name.type"
            ],
            "settings": {
                "foreground": "#C8B6FF"
            }
        },
        {
            "scope": [
                "keyword.control",
                "keyword.operator",
                "storage",
                "support.type",
                "keyword.operator.expression",
                "keyword.operator.new"
            ],
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": [
                "entity.name.function",
                "support.class",
                "support.function",
                "new.expr entity.name.type",
                "entity.other.inherited-class"
            ],
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": [
                "punctuation.definition.typeparameters",
                "keyword.operator.type",
                "keyword.operator.optional",
                "punctuation.definition.template-expression",
                "source.tsx punctuation.section.embedded",
                "source.jsx punctuation.section.embedded"
            ],
            "settings": {
                "foreground": "#F07171"
            }
        },
        {
            "scope": "constant",
            "settings": {
                "foreground": "#C8B6FF"
            }
        },
        {
            "scope": ["constant.numeric", "constant.language"],
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": [
                "variable.parameter",
                "parameter.variable",
                "meta.function.parameter variable",
                "source.rust meta.type_params.rust"
            ],
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": ["punctuation", "meta.brace"],
            "settings": {
                "foreground": "#a6a6a6"
            }
        },
        {
            "scope": [
                "variable.language.this",
                "variable.language.special.self"
            ],
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": "comment.block.documentation entity.name.type",
            "settings": {
                "foreground": "#F07171"
            }
        },
        {
            "scope": "variable.language.super",
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": [
                "meta.tag.metadata.doctype entity.name.tag",
                "meta.tag.metadata.doctype punctuation.definition.tag",
                "meta.tag.metadata.doctype string",
                "meta.tag.metadata.doctype entity.other.attribute-name.html",
                "meta.tag.sgml.doctype"
            ],
            "settings": {
                "foreground": "#a6a6a6"
            }
        },
        {
            "scope": "entity.name.tag",
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": "meta.tag string",
            "settings": {
                "foreground": "#2755a0"
            }
        },
        {
            "scope": [
                "meta.tag entity.other.attribute-name",
                "entity.other.attribute-name.html"
            ],
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": [
                "constant.character.entity",
                "punctuation.definition.entity"
            ],
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": ["entity.name.section.markdown", "markup.heading.setext"],
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": "punctuation.definition.list",
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": "meta.separator.markdown",
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": "markup.inline.raw",
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": "markup.bold",
            "settings": {
                "fontStyle": "bold"
            }
        },
        {
            "scope": "markup.italic",
            "settings": {
                "fontStyle": "italic"
            }
        },
        {
            "scope": [
                "meta.link punctuation.definition.string",
                "meta.image punctuation.definition.string"
            ],
            "settings": {
                "foreground": "#a6a6a6"
            }
        },
        {
            "scope": [
                "link",
                "markup.underline.link",
                "constant.other.reference.link.markdown"
            ],
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": "markup.quote",
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": ["entity.name.tag.css", "entity.name.tag.wildcard"],
            "settings": {
                "foreground": "#2755a0"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.class",
                "entity.other.attribute-name punctuation.definition.entity"
            ],
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.pseudo-element",
                "entity.other.attribute-name.pseudo-class",
                "constant.other.color"
            ],
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": [
                "entity.other.attribute-name.id",
                "entity.other.attribute-name.id punctuation.definition.entity"
            ],
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": [
                "source.css constant.numeric",
                "source.less constant.numeric",
                "source.scss constant.numeric"
            ],
            "settings": {
                "foreground": "#2755a0"
            }
        },
        {
            "scope": ["meta.property-name", "support.type.property-name"],
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": [
                "meta.property-value",
                "meta.property-value constant.other",
                "support.constant.property-value"
            ],
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": "variable.parameter.url",
            "settings": {
                "foreground": "#FFCE6B"
            }
        },
        {
            "scope": [
                "punctuation.section.embedded.begin.php",
                "punctuation.section.embedded.end.php"
            ],
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": "entity.name.section",
            "settings": {
                "foreground": "#FA8D3E"
            }
        },
        {
            "scope": "support.type.property-name.json",
            "settings": {
                "foreground": "#7DBFEF"
            }
        },
        {
            "scope": "markup.inserted",
            "settings": {
                "foreground": "#78BD65"
            }
        },
        {
            "scope": "markup.changed",
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": "markup.deleted",
            "settings": {
                "foreground": "#F07171"
            }
        },
        {
            "scope": "meta.diff.header",
            "settings": {
                "foreground": "#399EE6"
            }
        },
        {
            "scope": "meta.diff.range",
            "settings": {
                "foreground": "#399EE6"
            }
        }
    ]
}
