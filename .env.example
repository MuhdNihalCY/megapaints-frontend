# Frontend API base URL (no hardcoded hosts in code).
# Full URL including /api, e.g. for local backend:
# VITE_API_BASE_URL=http://localhost:3000/api
#
# For production, set to your backend API base (e.g. https://api.example.com/api).
# If unset, the app uses "/api" (same-origin).
VITE_API_BASE_URL=
